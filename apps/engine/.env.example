# MetaTrader 5 — terminal installé localement (Windows uniquement).
# Ouvrez MT5 → Fichier → Ouvrir un compte (démo) chez votre broker, puis
# renseignez ici le numéro de compte, le mot de passe et le serveur affichés
# à la création (ex. serveur "MetaQuotes-Demo").
#   MT5_LOGIN         : numéro du compte (laisser vide pour se rattacher au
#                       compte déjà connecté dans le terminal ouvert)
#   MT5_PASSWORD      : mot de passe du compte
#   MT5_SERVER        : serveur du broker (visible dans MT5 → Navigateur)
#   MT5_TERMINAL_PATH : chemin de terminal64.exe
#   BROKER_ENV        : demo (paper trading) ou live
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# true = ignorer login/password et se rattacher au compte déjà connecté dans
# le terminal MT5 (session enregistrée). Utile si le mot de passe MT5 n'est
# pas sous la main ; le verrou démo reste vérifié auprès du terminal.
MT5_ATTACH=false
BROKER_ENV=demo

# Décalage heure serveur MT5 -> UTC (souvent 2 l'hiver, 3 l'été chez la
# plupart des brokers). Sert à stocker les bougies en UTC comme l'historique
# Dukascopy. Vérifiez l'heure des bougies dans MT5 vs l'heure UTC réelle.
MT5_UTC_OFFSET_HOURS=3

# Symbole MT5 de l'or (XAU/USD). Selon le broker : XAUUSD, XAUUSD.a, GOLD...
SYMBOL=XAUUSD

# Stratégie scalp M5 : analyse de tendance sur M15/M30/H1, entrée sur M5,
# clôture dès que la position est en profit net.
MODEL_GRANULARITY=M5
TRADE_INTERVAL_SECONDS=60
# M1 inclus : requis pour les labels précis (MFE/MAE), le futur déclencheur M1
# de la stratégie sweep et la construction du M3.
INGEST_GRANULARITIES=M1,M5,M15,M30,H1
STRATEGY_NAME=scalp_m5
DECISION_CANDLES=200
PAPER_VALIDATION_MIN_TRADES=100

# Prise de profit anticipée (mode scalp) : cadence du moniteur de P&L et gain
# net minimal (devise du compte) avant clôture — coussin latence + slippage.
PROFIT_CHECK_INTERVAL_SECONDS=5
PROFIT_CLOSE_MIN_NET=0.5
# Auto-apprentissage borné des paramètres (état persisté dans models/scalp_m5/).
SCALP_ADAPT_ENABLED=true

# Proxy macro (EUR/USD = inverse du dollar). mt5_macro_symbol = symbole MT5.
MACRO_INSTRUMENT=EURUSD
MT5_MACRO_SYMBOL=EURUSD

# Kill switch global — laisser à false tant que le paper trading n'est pas validé
TRADING_ENABLED=false

# Limites de risque — 3 positions simultanées max, lot calculé par le
# RiskManager (1% du solde par trade, borné par la distance de stop).
# La perte jour/semaine = P&L réalisé (trades clôturés en DB) + flottant.
# Limites atteintes => kill switch dynamique verrouillé (réactivation
# explicite via POST /risk/unlock?reason=...).
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_WEEKLY_LOSS_PCT=6.0
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=4
COOLDOWN_AFTER_LOSS_MINUTES=15
COOLDOWN_AFTER_CONSECUTIVE_LOSSES_MINUTES=60

# Gardes d'exécution
MAX_SPREAD_PCT=0.001

# Filtre d'annonces économiques (fail-closed) : aucun nouvel ordre dans les
# fenêtres autour des annonces USD (source ForexFactory, sans clé), et aucun
# ordre si le calendrier est indisponible/trop vieux. Les clôtures ne sont
# jamais bloquées. Etat visible sur GET /fundamental/status.
NEWS_FILTER_ENABLED=true
NEWS_CURRENCIES=USD
NEWS_BLOCK_HIGH_PRE_MINUTES=30
NEWS_BLOCK_HIGH_POST_MINUTES=20
NEWS_BLOCK_MEDIUM_PRE_MINUTES=10
NEWS_BLOCK_MEDIUM_POST_MINUTES=10
NEWS_REFRESH_MINUTES=60
NEWS_MAX_AGE_MINUTES=360
REGIME_FILTER_ENFORCED=false
EXPECTED_RETURN_ALLOW_SHORT=false

# Boucle d'apprentissage (réentraînement périodique). Off par défaut (lourd).
LEARNING_ENABLED=false
LEARNING_INTERVAL_SECONDS=86400

# Jeton des routes mutantes du moteur (en-tête x-api-key). Vide = non protégé
# (tolérable en écoute 127.0.0.1 uniquement). Mettre la même valeur dans
# ENGINE_API_TOKEN de apps/api/.env pour que le proxy dashboard fonctionne.
ENGINE_API_TOKEN=

# Infra (docker-compose en local)
DATABASE_URL=postgresql://nexagold:nexagold@localhost:5433/nexagold
REDIS_URL=redis://localhost:6380

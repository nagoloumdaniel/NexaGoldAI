# Capital.com — activez la 2FA, basculez en mode Démo, puis Paramètres →
# API integrations → Generate API Key. Voir README (section Capital.com).
#   CAPITAL_API_KEY     : la clé générée
#   CAPITAL_IDENTIFIER  : l'e-mail de connexion du compte
#   CAPITAL_PASSWORD    : le mot de passe personnalisé défini pour la clé
#   CAPITAL_ENV         : demo (paper trading) ou live
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_ENV=demo

# Code de l'instrument Capital.com — GOLD = or (XAU/USD)
EPIC=GOLD

# Granularité du modèle live (H1 = meilleur résultat mesuré, Sharpe positif).
MODEL_GRANULARITY=H1
TRADE_INTERVAL_SECONDS=3600
INGEST_GRANULARITIES=M5,H1

# Proxy macro (EUR/USD = inverse du dollar). capital_macro_epic = epic live.
MACRO_INSTRUMENT=EURUSD
CAPITAL_MACRO_EPIC=EURUSD

# Kill switch global — laisser à false tant que le paper trading n'est pas validé
TRADING_ENABLED=false

# Limites de risque
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=1

# Boucle d'apprentissage (réentraînement périodique). Off par défaut (lourd).
LEARNING_ENABLED=false
LEARNING_INTERVAL_SECONDS=86400

# Infra (Neon + Upstash en production, docker-compose en local)
DATABASE_URL=postgresql://nexagold:nexagold@localhost:5433/nexagold
REDIS_URL=redis://localhost:6380

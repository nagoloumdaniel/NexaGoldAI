# OANDA — créez un compte démo sur https://www.oanda.com puis générez un token
# API dans "Manage API Access". oanda_env: practice (démo) ou live.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Instrument tradé
INSTRUMENT=XAU_USD

# Kill switch global — laisser à false tant que le paper trading n'est pas validé
TRADING_ENABLED=false

# Limites de risque
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=1

# Infra (Neon + Upstash en production, docker-compose en local)
DATABASE_URL=postgresql://nexagold:nexagold@localhost:5433/nexagold
REDIS_URL=redis://localhost:6380

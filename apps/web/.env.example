# URL de l'API NestJS (Railway en production, local par défaut)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clé des routes mutantes de l'API (même valeur que API_KEY dans apps/api/.env).
# Attention : NEXT_PUBLIC_* est visible dans le bundle navigateur — c'est un
# verrou d'opérateur local, pas un vrai secret.
NEXT_PUBLIC_API_KEY=

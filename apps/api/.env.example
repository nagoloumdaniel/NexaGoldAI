# PostgreSQL — Neon en production (copier la "Connection string" du dashboard
# Neon, avec ?sslmode=require), docker-compose en local.
DATABASE_URL=postgresql://nexagold:nexagold@localhost:5433/nexagold

# Redis — Upstash en production (URL rediss://), docker-compose en local.
REDIS_URL=redis://localhost:6380

# URL du frontend autorisée par CORS (Vercel en production)
FRONTEND_URL=http://localhost:3000

# URL interne du moteur Python
ENGINE_URL=http://localhost:8000

# Secret JWT (à générer : openssl rand -hex 32)
JWT_SECRET=change-me

PORT=3001

# Bot Telegram pour le rapport quotidien (voir README, section Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Heure du rapport quotidien (cron UTC) — défaut : 21h00 UTC du lundi au vendredi
REPORT_CRON=0 21 * * 1-5
